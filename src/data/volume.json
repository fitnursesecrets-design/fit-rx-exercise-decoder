  "tableNote": "Start in the beginner column for 2–4 weeks, then increase only the muscles you care about most.",
  "designSteps": [
    {
      "step": "1",
      "title": "Pick the priority muscle",
      "text": "Do not try to grow everything equally. Pick 1–3 focus areas — e.g. glutes + waist contrast, back + shoulders, or full-body recomposition."
    },
    {
      "step": "2",
      "title": "Assign weekly sets",
      "text": "Example for glutes + legs + upper-body shape: Glutes 10 · Quads 8 · Hamstrings 6 · Chest 6 · Back 9 · Shoulders 8 · Arms 4–6. That is plenty."
    },
    {
      "step": "3",
      "title": "Split sets across the week",
      "text": "Do not dump all sets into one workout. Glutes 10/week → 5 Monday + 5 Thursday. Most muscles grow well with 2–3 exposures per week."
    }
  ],

{
  "title": "Volume Decoder",
  "subtitle": "How many sets + reps per muscle to build workouts",
  "intro": "Muscle growth is not about doing random exercises until you are tired. It is about giving each muscle enough hard sets per week to grow — without doing so much that recovery crashes.",
  "hardSet": {
    "label": "What counts as a hard set?",
    "text": "Train close to failure, usually leaving 1–3 reps in reserve. If you could have done 12 reps but stopped at 10, that is about 2 reps in reserve. Challenged, but not destroyed."
  },
  "zones": [
    {
      "name": "Maintenance Volume",
      "desc": "Keeps your current muscle. Good for busy weeks, stressful shifts, or when fat loss is the main goal."
    },
    {
      "name": "Minimum Effective Volume",
      "desc": "The lowest amount that can still produce progress. Where most beginners should start."
    },
    {
      "name": "Maximum Adaptive Volume",
      "desc": "The sweet spot where most growth happens. Where intermediate clients spend most of their time."
    },
    {
      "name": "Maximum Recoverable Volume",
      "desc": "The highest amount you can recover from. Most lifestyle clients do not need to live here."
    }
  ],
